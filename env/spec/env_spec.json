{
  "name": "flight-booking-dev-fixture",
  "site_url": "dev-fixture (stands in until A delivers a real spec)",
  "interaction": "search results are paginated; the target flight may be on any page — agent must paginate",
  "entities": {
    "flights": {
      "generator": "flights",
      "count_range": [22, 45],
      "columns": {
        "id": "INTEGER PRIMARY KEY",
        "flight_no": "TEXT",
        "airline": "TEXT",
        "departs_at": "TEXT",
        "price": "INTEGER",
        "direct": "INTEGER"
      }
    }
  },
  "mutations": {
    "bookings": {
      "columns": {
        "id": "INTEGER PRIMARY KEY",
        "flight_id": "INTEGER",
        "name": "TEXT",
        "email": "TEXT",
        "created_at": "REAL"
      },
      "form_fields": [
        {"name": "name", "type": "text", "label": "Full name", "required": true},
        {"name": "email", "type": "email", "label": "Email", "required": true}
      ]
    }
  },
  "routes": {
    "entry": "/",
    "detail": {"path": "/flights/<int:eid>", "entity": "flights", "title_field": "flight_no"},
    "mutation": {"path": "/flights/<int:eid>/book", "method": "POST", "table": "bookings", "fk_column": "flight_id"},
    "confirmation": {"path": "/bookings/<int:bid>", "table": "bookings",
                     "join": {"table": "flights", "fk": "flight_id", "fields": ["flight_no", "airline", "departs_at", "price"]}}
  },
  "component": {"name": "flight_search", "html": "component/component.html", "js": "component/component.js"},
  "backend_calls": [
    {"method": "GET", "path": "/api/flights", "table": "flights", "paginated": true, "per_page": 10}
  ],
  "expected_mutation": "a bookings row whose flight_id matches the task constraint (e.g. argmin price)",
  "seed_data": {},
  "failure_step": null,
  "failure_note": "dev fixture — pagination is the intended failure mode"
}
